{
  "name": "@costshield/api",
  "version": "1.0.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate": "node -r ts-node/register ../../node_modules/.bin/sequelize db:migrate",
    "migrate:undo": "node -r ts-node/register ../../node_modules/.bin/sequelize db:migrate:undo",
    "seed": "node -r ts-node/register ../../node_modules/.bin/sequelize db:seed:all",
    "seed:undo": "node -r ts-node/register ../../node_modules/.bin/sequelize db:seed:undo:all",
    "test:track": "ts-node-dev --transpile-only -r dotenv/config scripts/testTrackConcurrency.ts"
  },
  "dependencies": {
    "@costshield/shared": "*",
    "axios": "^1.13.6",
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.3.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "openid-client": "^6.8.2",
    "passport": "^0.7.0",
    "passport-github2": "^0.1.12",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.13.0",
    "pg-hstore": "^2.3.4",
    "resend": "^4.0.0",
    "sequelize": "^6.37.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.0.0",
    "@types/passport": "^1.0.17",
    "@types/passport-github2": "^1.2.9",
    "@types/passport-google-oauth20": "^2.0.16",
    "sequelize-cli": "^6.6.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.0"
  }
}
